# ══════════════════════════════════════════════════════════════════════════════
# FASHIONISTAR FRONTEND — Environment Variables
# ══════════════════════════════════════════════════════════════════════════════
# Copy this to .env.local and fill in real values.
# NEVER commit .env.local to Git.
# ══════════════════════════════════════════════════════════════════════════════

# ── App Identity ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=FASHIONISTAR AI
NEXT_PUBLIC_VERSION=2.0.0
NEXT_PUBLIC_ENV=development

# ── Backend API (Django) ── REQUIRED ─────────────────────────────────────────
# DRF Sync endpoints — Auth, Orders, Products, Payments
NEXT_PUBLIC_API_V1_URL=https://fashionistar-backend-964702203189.europe-west1.run.app/api
# Ninja Async endpoints — AI, Search, Analytics
NEXT_PUBLIC_API_V2_URL=https://fashionistar-backend-964702203189.europe-west1.run.app/api/v1/ninja
# Raw backend base (no /api suffix) — used by rewrites in next.config.mjs
NEXT_PUBLIC_BACKEND_URL=https://fashionistar-backend-964702203189.europe-west1.run.app

# ── Frontend App URL ─────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://aeration-scabby-navy.ngrok-free.dev
# FRONTEND NGROK Tunnel — SPECIFICALLY MADE FOR FRONTEND USING ITS OWN DEDICATED NGROK_FRONTEND_TOKEN
NEXT_PUBLIC_FRONTEND_TUNNEL_URL=https://aeration-scabby-navy.ngrok-free.dev

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Get from: console.cloud.google.com/apis/credentials
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_SECRET=your-google-client-secret
# ── Cloudinary CDN ── from fashionistar_backend/.env ─────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD=dgpdlknc1
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=fashionista_ai
CLOUDINARY_API_KEY=965289429995279
CLOUDINARY_API_SECRET=I76o1iQ3pTR1sDTpj0qXrbu5eVE

# ── Auth / Session ────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=fashionistar_super_secret_key_change_in_production_32chars
NEXTAUTH_URL=http://localhost:3000
JWT_SECRET=fashionistar_jwt_secret_key_change_in_production

# ── Sentry Error Monitoring ───────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=fashionistar
SENTRY_PROJECT=fashionistar-frontend

# ── Payments ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ── Analytics ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G_MEASUREMENT_ID
NEXT_PUBLIC_OTEL_ENABLED=false
NEXT_PUBLIC_OTEL_ENDPOINT=http://localhost:4318

# ── Feature Flags ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_FEATURE_AI_MEASUREMENTS=true
NEXT_PUBLIC_FEATURE_SOCIAL_LOGIN=true
NEXT_PUBLIC_FEATURE_BETA_CHECKOUT=false

# ── Internationalization ──────────────────────────────────────────────────────
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_SUPPORTED_LOCALES=en,fr,es,pt,ar

# ── Email ─────────────────────────────────────────────────────────────────────
EMAIL_SERVICE_URL=https://api.resend.com/emails
EMAIL_FROM=noreply@fashionistar.com
EMAIL_API_KEY=your_email_api_key

# ── Debug ─────────────────────────────────────────────────────────────────────
DEBUG=false
DEBUG_STORAGE=false
NEXT_PUBLIC_VERBOSE_ERROR=false

# ── AI Camera & MediaPipe ─────────────────────────────────────────────────────
NEXT_PUBLIC_MEDIAPIPE_WASM_URL=https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.14/wasm
NEXT_PUBLIC_POSE_MODEL_URL=https://storage.googleapis.com/mediapipe-models/pose_landmarker/pose_landmarker_full/float16/latest/pose_landmarker_full.task

# ── QR Code Gateway & Device-Aware Measurement Routing ────────────────────────
# Base URL for public /scan/[session_id] route — used in QR code + social share links
# Dev:  http://localhost:3000/scan
# Prod: https://fashionistar.net/scan
NEXT_PUBLIC_SCAN_BASE_URL=http://localhost:3000/scan

# QR session countdown timer in hours (shown on DesktopQRGateway component)
NEXT_PUBLIC_QR_SESSION_EXPIRY_HOURS=24

# Feature flag — set to false to always bypass QR gateway and go directly to scan
NEXT_PUBLIC_FEATURE_DESKTOP_QR_GATEWAY=true
